{
  "name": "tvfacil",
  "version": "0.1.0",
  "description": "TvFácil — IPTV simples para Windows",
  "main": "dist-electron/main.js",
  "author": "TvFácil",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:win": "npm run build && electron-builder --win nsis portable --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "build": {
    "appId": "pt.tvfacil.app",
    "productName": "TvFácil",
    "copyright": "Copyright © TvFácil",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TvFácil",
      "installerLanguages": ["pt_PT", "pt_BR", "en_US"],
      "language": "2070"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.5.1"
  }
}
